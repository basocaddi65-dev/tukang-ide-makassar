<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Real Cost Perencanaan Arsitek Resmi</title>
    <style>
        :root {
            --primary: #1e293b;
            --accent: #0f766e;
            --bg: #f1f5f9;
            --text: #334155;
            --white: #ffffff;
            --border: #e2e8f0;
        }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 950px;
            margin: 0 auto;
            background: var(--white);
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        }
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 3px solid var(--accent);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header-app {
            flex: 1;
        }
        .header-app h1 {
            margin: 0;
            color: var(--primary);
            font-size: 24px;
        }
        .header-app p {
            margin: 5px 0 0 0;
            color: #64748b;
            font-size: 14px;
        }
        .logo-studio-box {
            width: 120px;
            height: 120px;
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #f8fafc;
            position: relative;
        }
        .logo-studio-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        .logo-input-label {
            font-size: 11px;
            color: #64748b;
            text-align: center;
            cursor: pointer;
            padding: 5px;
        }
        .logo-studio-box input[type="file"] {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }
        h3 {
            color: var(--primary);
            border-left: 4px solid var(--accent);
            padding-left: 10px;
            margin-top: 30px;
            font-size: 18px;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            background: #f8fafc;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
            margin-bottom: 25px;
        }
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            background: #ffffff;
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 0px;
        }
        .form-group-block {
            margin-bottom: 15px;
        }
        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
        }
        select, input[type="number"], input[type="text"], input[type="date"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 15px;
            background: #ffffff;
            color: var(--text);
            transition: all 0.2s;
        }
        select:focus, input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
        }
        .info-wilayah {
            font-size: 13px;
            color: #0f766e;
            margin-top: 6px;
            font-style: italic;
            font-weight: 500;
        }
        .table-responsive {
            overflow-x: auto;
            margin-top: 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            text-align: left;
        }
        th, td {
            padding: 12px;
            border-bottom: 1px solid var(--border);
        }
        th {
            background-color: #f8fafc;
            color: var(--primary);
            font-weight: 600;
        }
        .input-inline {
            width: 95px !important;
            padding: 6px !important;
            font-size: 14px !important;
            text-align: center;
        }
        .highlight-row {
            background-color: #f0fdfa;
            font-weight: 600;
        }
        .btn-container {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }
        button {
            flex: 1;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-calc { background-color: var(--accent); }
        .btn-calc:hover { background-color: #0d655f; }
        .btn-print { background-color: #475569; }
        .btn-print:hover { background-color: #334155; }
        
        .result-box {
            margin-top: 35px;
            background: #f8fafc;
            border: 2px solid var(--border);
            padding: 25px;
            border-radius: 8px;
            display: none;
        }
        .result-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 15px;
        }
        .result-item.total {
            font-size: 22px;
            font-weight: 700;
            color: #0f766e;
            border-top: 3px double #cbd5e1;
            padding-top: 15px;
            margin-top: 15px;
        }
        
        .print-only-block {
            display: none;
            background: #f8fafc;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            line-height: 1.6;
        }

        /* Peraturan CSS Khusus PDF / Printer */
        @media print {
            body { background-color: #ffffff; padding: 0; color: #000000; }
            .container { box-shadow: none; padding: 0; max-width: 100%; }
            .btn-container, .input-inline, select, #margin-profit, .no-print, .logo-input-label, .grid-2, .grid-3 { display: none !important; }
            .logo-studio-box { border: none !important; background: transparent !important; }
            .print-only-block { display: block !important; border: 1px solid #cbd5e1; }
            .result-box { display: block !important; border: none; padding: 0; margin-top: 20px; }
            th, td { padding: 8px; border-bottom: 1px solid #94a3b8; }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header-container">
        <div class="header-app">
            <h1>Kalkulator Proposal Jasa Arsitektur Standar IAI</h1>
            <p>Aplikasi Estimasi Anggaran Riil Personel & Operasional Non-Personel Wilayah Sulawesi Selatan</p>
        </div>
        <!-- Kolom Logo Kustom -->
        <div class="logo-studio-box">
            <div class="logo-input-label" id="label-logo">Klik / Seret<br>Logo Studio</div>
            <img id="preview-logo" src="" alt="" style="display: none;">
            <input type="file" id="input-logo" accept="image/*" onchange="loadLogo(event)">
        </div>
    </div>

    <!-- Informasi Administrasi Penawaran -->
    <h3>1. Informasi Administrasi Proposal</h3>
    <div class="grid-3">
        <div class="form-group-block">
            <label for="nama-proyek">Nama Proyek Perencanaan:</label>
            <input type="text" id="nama-proyek" placeholder="Contoh: Perencanaan Gedung Kantor Bertingkat">
        </div>
        <div class="form-group-block">
            <label for="nama-klien">Nama Calon Klien / Instansi:</label>
            <input type="text" id="nama-klien" placeholder="Contoh: PT. Maju Bersama Makmur">
        </div>
        <div class="form-group-block">
            <label for="tgl-penawaran">Tanggal Penawaran Dokumen:</label>
            <input type="date" id="tgl-penawaran">
        </div>
    </div>

    <!-- Blok Keterangan Khusus Tampilan PDF -->
    <div class="print-only-block" id="pdf-meta-box">
        <strong>DOKUMEN LAMPIRAN PENAWARAN BIAYA</strong><br>
        <span id="print-proyek">Nama Proyek: -</span><br>
        <span id="print-klien">Klien / Pemilik: -</span><br>
        <span id="print-tanggal">Tanggal Penawaran: -</span><br>
        <span id="print-lokasi">Lokasi Wilayah Kerja: -</span>
    </div>
    
    <!-- Parameter Utama Proyek -->
    <h3>2. Parameter Kriteria Bangunan</h3>
    <div class="grid-2">
        <div class="form-group">
            <label for="wilayah">Lokasi Proyek (24 Kabupaten/Kota Sulsel):</label>
            <select id="wilayah" onchange="updateBiayaWilayah()">
                <option value="makassar" data-biaya="1000000" data-ket="Kota Makassar: Basis internal operasional (Lokal tanpa inap).">Kota Makassar</option>
                <option value="parepare" data-biaya="3500000" data-ket="Kota Parepare: Lintas pesisir barat (Trans Sulawesi).">Kota Parepare</option>
                <option value="palopo" data-biaya="6500000" data-ket="Kota Palopo: Klaster Luwu Raya (Jarak jauh & alokasi penginapan).">Kota Palopo</option>
